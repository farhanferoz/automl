  "confound_check": {
    "environment": "Identical git commit (4cc9aeb2e5), same torch/numpy/platform, same threading (omp_num_threads=4, torch_num_threads=4, cpu_count=22), same device=cpu, in both arms' provenance blocks -- rules out an environment/threading confound for the per-epoch cost comparison.",
    "untrustworthy_seeds": "Both arms report `untrustworthy_seeds: []` -- zero untrustworthy seeds in either arm, consistent with the brief's premise."
